# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# LLM Provider (supports: deepseek, openai, anthropic)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key

# GitHub (optional, for repo cloning)
GITHUB_TOKEN=ghp-your-github-token

# Daytona sandbox (optional — clones GitHub repos in isolated VMs for live scans)
DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# DAYTONA_DISABLE=1

# App config
PORT=3000
NODE_ENV=development

# Optional default URL for MCP protocol health checks (handshake ≠ HTTP 200)
# MCP_HEALTH_URL=https://example.com/mcp

# Streamable HTTP MCP (public / Glama). Required to bind mcp-server/http.js.
# Generate a long random secret; never commit it. Missing token = process exits.
# MCP_BEARER_TOKEN=
# Bind address / port for the HTTP MCP process (defaults: 127.0.0.1:8787 locally)
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_HTTP_PATH=/mcp
# JSON responses (default) or SSE streams: 1 | 0
# MCP_HTTP_JSON_RESPONSE=1